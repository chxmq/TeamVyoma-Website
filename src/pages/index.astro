---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <img src="/images/white_logo.png" alt="Team Vyoma Logo" class="hero-logo" />
            <h1>Team Vyoma</h1>
            <p>Pioneering the future of aerospace through innovation, design, and engineering excellence</p>
            
            <div class="cta-buttons">
                <a href="/about" class="btn btn-primary">
                    <i class="fas fa-rocket"></i>
                    Discover Our Story
                </a>
                <a href="/projects" class="btn btn-secondary">
                    <i class="fas fa-plane"></i>
                    View Projects
                </a>
            </div>
        </div>
    </section>

    <!-- Vision Section -->
    <section class="section">
        <div class="section-header">
            <h2 class="section-title">Our Vision</h2>
            <p class="section-subtitle">
                To foster innovation and creativity in the field of aeromodelling, 
                developing cutting-edge UAV technologies for a better tomorrow
            </p>
        </div>
        
        <div class="cards-grid">
            <div class="card">
                <div class="card-icon">
                    <i class="fas fa-lightbulb"></i>
                </div>
                <h3>Innovation</h3>
                <p>Pushing the boundaries of aerospace technology through creative problem-solving and cutting-edge research in unmanned aerial systems.</p>
            </div>
            
            <div class="card">
                <div class="card-icon">
                    <i class="fas fa-users"></i>
                </div>
                <h3>Collaboration</h3>
                <p>Building a community of passionate engineers and designers working together to achieve excellence in aeromodelling and UAV development.</p>
            </div>
            
            <div class="card">
                <div class="card-icon">
                    <i class="fas fa-trophy"></i>
                </div>
                <h3>Excellence</h3>
                <p>Striving for perfection in every project, from design conception to final implementation, maintaining the highest standards of quality.</p>
            </div>
        </div>
    </section>

    <!-- Featured Projects -->
    <section class="section" style="background: white;">
        <div class="section-header">
            <h2 class="section-title">Featured Projects</h2>
            <p class="section-subtitle">
                Explore our latest innovations in aerospace engineering and UAV technology
            </p>
        </div>
        
        <div class="project-card">
            <div class="project-content">
                <img src="/images/rcairplane.jpg" alt="RC Model Airplanes" class="project-image" />
                <div class="project-info">
                    <h3>RC Model Airplanes</h3>
                    <p>Advanced radio-controlled aircraft designed for competitions and research. Our models incorporate cutting-edge aerodynamics and materials science.</p>
                    <p>We've achieved top rankings in national competitions, showcasing our commitment to engineering excellence.</p>
                    <a href="/projects/model" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>
        
        <div class="project-card">
            <div class="project-content reverse">
                <div class="project-info">
                    <h3>Fixed-Wing VTOL</h3>
                    <p>Revolutionary vertical takeoff and landing aircraft that combines the efficiency of fixed-wing flight with helicopter-like versatility.</p>
                    <p>Perfect for surveillance, delivery, and research applications in confined spaces.</p>
                    <a href="/projects/vtol" class="btn btn-primary">Explore Project</a>
                </div>
                <img src="/images/vtol.jpg" alt="Fixed-Wing VTOL" class="project-image" />
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="section" style="background: linear-gradient(135deg, #0066cc 0%, #30c5dc 100%); color: white;">
        <div class="section-header">
            <h2 class="section-title" style="color: white;">Our Impact</h2>
            <p class="section-subtitle" style="color: rgba(255, 255, 255, 0.9);">
                Numbers that showcase our journey and achievements in aerospace innovation
            </p>
        </div>
        
        <div class="cards-grid">
            <div class="card" style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2);">
                <div class="card-icon" style="background: rgba(255, 255, 255, 0.2);">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <h3 style="color: white; font-size: 2.5rem; margin-bottom: 0.5rem;">17+</h3>
                <p style="color: rgba(255, 255, 255, 0.9);">Years of Excellence</p>
            </div>
            
            <div class="card" style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2);">
                <div class="card-icon" style="background: rgba(255, 255, 255, 0.2);">
                    <i class="fas fa-award"></i>
                </div>
                <h3 style="color: white; font-size: 2.5rem; margin-bottom: 0.5rem;">50+</h3>
                <p style="color: rgba(255, 255, 255, 0.9);">Awards Won</p>
            </div>
            
            <div class="card" style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2);">
                <div class="card-icon" style="background: rgba(255, 255, 255, 0.2);">
                    <i class="fas fa-plane"></i>
                </div>
                <h3 style="color: white; font-size: 2.5rem; margin-bottom: 0.5rem;">100+</h3>
                <p style="color: rgba(255, 255, 255, 0.9);">Aircraft Built</p>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact-section">
        <div class="contact-content">
            <div class="contact-info">
                <h2>Get In Touch</h2>
                <p>Ready to join our mission or collaborate with us? We'd love to hear from you!</p>
                
                <div class="contact-details">
                    <div class="contact-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <div>
                            <h4 style="color: white; margin-bottom: 0.5rem;">Location</h4>
                            <p style="opacity: 0.9; margin: 0;">RV College of Engineering, Bangalore</p>
                        </div>
                    </div>
                    
                    <div class="contact-item">
                        <i class="fas fa-envelope"></i>
                        <div>
                            <h4 style="color: white; margin-bottom: 0.5rem;">Email</h4>
                            <p style="opacity: 0.9; margin: 0;">projectvyoma@rvce.edu.in</p>
                        </div>
                    </div>
                    
                    <div class="contact-item">
                        <i class="fas fa-users"></i>
                        <div>
                            <h4 style="color: white; margin-bottom: 0.5rem;">Join Us</h4>
                            <p style="opacity: 0.9; margin: 0;">Open to passionate engineering students</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="contact-form">
                <h3 style="color: var(--dark-navy); margin-bottom: 1.5rem;">Send us a message</h3>
                <form>
                    <div class="form-group">
                        <label for="name">Full Name</label>
                        <input type="text" id="name" name="name" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone">
                    </div>
                    
                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" required placeholder="Tell us about your interest in aerospace or how you'd like to collaborate..."></textarea>
                    </div>
                    
                    <button type="submit" class="btn btn-primary" style="width: 100%;">
                        <i class="fas fa-paper-plane"></i>
                        Send Message
                    </button>
                </form>
            </div>
        </div>
    </section>
</Layout>