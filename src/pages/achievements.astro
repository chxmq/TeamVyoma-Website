---
import Layout from "../layouts/Layout.astro";
import { achievements } from "../lib/achievements";
---

<Layout title="Achievements - Team Vyoma" description="Discover Team Vyoma's impressive achievements and awards in aerospace competitions and innovation.">
    <!-- Hero Section -->
    <section class="hero" style="min-height: 60vh;">
        <div class="hero-content">
            <h1>Our Achievements</h1>
            <p>Celebrating excellence in aerospace engineering and innovation</p>
        </div>
    </section>

    <!-- Achievements Section -->
    <section class="section">
        <div class="section-header">
            <h2 class="section-title">Awards & Recognition</h2>
            <p class="section-subtitle">
                A testament to our commitment to excellence and innovation in aerospace engineering
            </p>
        </div>
        
        <div class="cards-grid">
            {achievements.map((achievement, index) => (
                <div class="card" style={`animation-delay: ${index * 0.1}s`}>
                    <div style="text-align: center; margin-bottom: 1.5rem;">
                        <img 
                            src={achievement.src} 
                            alt={achievement.heading}
                            style="width: 100%; max-width: 200px; height: 150px; object-fit: contain; border-radius: 10px;"
                        />
                    </div>
                    <h3 style="color: var(--primary-blue); margin-bottom: 1rem; text-align: center;">
                        {achievement.heading}
                    </h3>
                    <p style="text-align: center; line-height: 1.6;">
                        {achievement.description}
                    </p>
                </div>
            ))}
        </div>
    </section>

    <!-- Highlights Section -->
    <section class="section" style="background: white;">
        <div class="section-header">
            <h2 class="section-title">Major Milestones</h2>
            <p class="section-subtitle">
                Key moments that defined our journey in aerospace excellence
            </p>
        </div>
        
        <div style="max-width: 800px; margin: 0 auto;">
            <div class="card" style="margin-bottom: 2rem; border-left: 4px solid var(--primary-blue);">
                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                    <div class="card-icon" style="margin: 0;">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <div>
                        <h3 style="color: var(--primary-blue); margin: 0;">NASA Systems Engineering Award</h3>
                        <p style="color: var(--medium-gray); margin: 0; font-size: 0.9rem;">2013 • SAE Aero Design West</p>
                    </div>
                </div>
                <p>Recognized as the best among 75 international teams for our exceptional systems engineering approach and innovative aircraft design.</p>
            </div>
            
            <div class="card" style="margin-bottom: 2rem; border-left: 4px solid var(--secondary-blue);">
                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                    <div class="card-icon" style="margin: 0; background: var(--secondary-blue);">
                        <i class="fas fa-flag"></i>
                    </div>
                    <div>
                        <h3 style="color: var(--secondary-blue); margin: 0;">First Indian Team at AIAA DBF</h3>
                        <p style="color: var(--medium-gray); margin: 0; font-size: 0.9rem;">2015 • Tucson, Arizona</p>
                    </div>
                </div>
                <p>Made history as the first Indian team to successfully take off at an AIAA Design/Build/Fly competition, paving the way for future participation.</p>
            </div>
            
            <div class="card" style="margin-bottom: 2rem; border-left: 4px solid var(--accent-orange);">
                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                    <div class="card-icon" style="margin: 0; background: var(--accent-orange);">
                        <i class="fas fa-medal"></i>
                    </div>
                    <div>
                        <h3 style="color: var(--accent-orange); margin: 0;">Top 20 Boeing Competition</h3>
                        <p style="color: var(--medium-gray); margin: 0; font-size: 0.9rem;">2023 • National Level</p>
                    </div>
                </div>
                <p>Secured position in top 20 out of 600 competing teams in the Boeing National Aeromodelling Competition, demonstrating continued excellence.</p>
            </div>
            
            <div class="card" style="border-left: 4px solid var(--primary-blue);">
                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                    <div class="card-icon" style="margin: 0;">
                        <i class="fas fa-star"></i>
                    </div>
                    <div>
                        <h3 style="color: var(--primary-blue); margin: 0;">Presidential Recognition</h3>
                        <p style="color: var(--medium-gray); margin: 0; font-size: 0.9rem;">2011 • India</p>
                    </div>
                </div>
                <p>Received certificate of appreciation from the President of India for being the first team to represent India at international aerospace competitions.</p>
            </div>
        </div>
    </section>

    <!-- Statistics Section -->
    <section class="section" style="background: linear-gradient(135deg, #0066cc 0%, #30c5dc 100%); color: white;">
        <div class="section-header">
            <h2 class="section-title" style="color: white;">By the Numbers</h2>
            <p class="section-subtitle" style="color: rgba(255, 255, 255, 0.9);">
                Our achievements quantified
            </p>
        </div>
        
        <div class="cards-grid">
            <div class="card" style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); text-align: center;">
                <h3 style="color: white; font-size: 3rem; margin-bottom: 0.5rem;">50+</h3>
                <p style="color: rgba(255, 255, 255, 0.9); font-size: 1.1rem;">Awards Won</p>
            </div>
            
            <div class="card" style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); text-align: center;">
                <h3 style="color: white; font-size: 3rem; margin-bottom: 0.5rem;">15+</h3>
                <p style="color: rgba(255, 255, 255, 0.9); font-size: 1.1rem;">International Competitions</p>
            </div>
            
            <div class="card" style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); text-align: center;">
                <h3 style="color: white; font-size: 3rem; margin-bottom: 0.5rem;">100+</h3>
                <p style="color: rgba(255, 255, 255, 0.9); font-size: 1.1rem;">Aircraft Designed</p>
            </div>
            
            <div class="card" style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); text-align: center;">
                <h3 style="color: white; font-size: 3rem; margin-bottom: 0.5rem;">17+</h3>
                <p style="color: rgba(255, 255, 255, 0.9); font-size: 1.1rem;">Years of Excellence</p>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="section" style="background: white; text-align: center;">
        <div style="max-width: 600px; margin: 0 auto;">
            <h2 style="color: var(--dark-navy); font-size: 2.5rem; margin-bottom: 1rem;">Ready to Make History?</h2>
            <p style="font-size: 1.25rem; margin-bottom: 2rem; color: var(--medium-gray);">
                Join us in our mission to push the boundaries of aerospace technology and achieve new milestones in engineering excellence.
            </p>
            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a href="/team" class="btn btn-primary">
                    <i class="fas fa-users"></i>
                    Join Our Team
                </a>
                <a href="/projects" class="btn btn-secondary">
                    <i class="fas fa-rocket"></i>
                    View Projects
                </a>
            </div>
        </div>
    </section>
</Layout>