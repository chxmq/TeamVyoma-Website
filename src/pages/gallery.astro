---
import Layout from "../layouts/Layout.astro";
import { galleryImages } from "../lib/gallery";
---

<Layout title="Gallery - Team Vyoma" description="Explore Team Vyoma's visual journey through photos of our aircraft, competitions, and team moments.">
    <!-- Hero Section -->
    <section class="hero" style="min-height: 60vh;">
        <div class="hero-content">
            <h1>Gallery</h1>
            <p>Capturing moments of innovation, teamwork, and aerospace excellence</p>
        </div>
    </section>

    <!-- Gallery Section -->
    <section class="section">
        <div class="section-header">
            <h2 class="section-title">Our Journey in Pictures</h2>
            <p class="section-subtitle">
                From design workshops to international competitions - see our story unfold
            </p>
        </div>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 3rem;">
            {galleryImages.map((image, index) => (
                <div 
                    class="card" 
                    style={`padding: 0; overflow: hidden; cursor: pointer; animation-delay: ${index * 0.05}s`}
                    onclick={`openModal('${image.src}', '${image.desc}')`}
                >
                    <img 
                        src={image.src} 
                        alt={image.desc}
                        style="width: 100%; height: 250px; object-fit: cover; transition: transform 0.3s ease;"
                        onmouseover="this.style.transform='scale(1.05)'"
                        onmouseout="this.style.transform='scale(1)'"
                    />
                    <div style="padding: 1rem;">
                        <p style="margin: 0; color: var(--medium-gray); text-align: center;">{image.desc}</p>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- Categories Section -->
    <section class="section" style="background: white;">
        <div class="section-header">
            <h2 class="section-title">Explore by Category</h2>
            <p class="section-subtitle">
                Discover different aspects of our aerospace journey
            </p>
        </div>
        
        <div class="cards-grid">
            <div class="card" style="cursor: pointer;" onclick="filterGallery('aircraft')">
                <div class="card-icon">
                    <i class="fas fa-plane"></i>
                </div>
                <h3>Aircraft & Designs</h3>
                <p>Our innovative aircraft designs, from concept sketches to finished models ready for flight testing.</p>
            </div>
            
            <div class="card" style="cursor: pointer;" onclick="filterGallery('competitions')">
                <div class="card-icon">
                    <i class="fas fa-trophy"></i>
                </div>
                <h3>Competitions</h3>
                <p>Moments from national and international competitions where we showcase our engineering excellence.</p>
            </div>
            
            <div class="card" style="cursor: pointer;" onclick="filterGallery('workshop')">
                <div class="card-icon">
                    <i class="fas fa-tools"></i>
                </div>
                <h3>Workshop & Manufacturing</h3>
                <p>Behind-the-scenes look at our design and manufacturing processes in our state-of-the-art workshop.</p>
            </div>
            
            <div class="card" style="cursor: pointer;" onclick="filterGallery('team')">
                <div class="card-icon">
                    <i class="fas fa-users"></i>
                </div>
                <h3>Team Moments</h3>
                <p>Celebrating our team spirit, achievements, and the bonds that drive our success.</p>
            </div>
        </div>
    </section>

    <!-- Modal for Image Viewing -->
    <div id="imageModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.9); z-index: 2000; cursor: pointer;" onclick="closeModal()">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); max-width: 90%; max-height: 90%;">
            <img id="modalImage" style="width: 100%; height: auto; border-radius: 10px;" />
            <p id="modalCaption" style="color: white; text-align: center; margin-top: 1rem; font-size: 1.1rem;"></p>
        </div>
        <button onclick="closeModal()" style="position: absolute; top: 20px; right: 30px; background: none; border: none; color: white; font-size: 2rem; cursor: pointer;">&times;</button>
    </div>

    <script>
        function openModal(src, caption) {
            document.getElementById('imageModal').style.display = 'block';
            document.getElementById('modalImage').src = src;
            document.getElementById('modalCaption').textContent = caption;
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            document.getElementById('imageModal').style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        function filterGallery(category) {
            // This would filter the gallery based on category
            // For now, it's a placeholder for future implementation
            console.log('Filtering by:', category);
        }

        // Close modal with Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeModal();
            }
        });
    </script>
</Layout>